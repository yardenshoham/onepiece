{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "Limit frequent OpenRouter SDK updates to one weekly window",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/OpenRouterTeam/go-sdk"
      ],
      "schedule": [
        "* 0-3 * * 1"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update golangci-lint version in GitHub workflows",
      "managerFilePatterns": [
        "/\\.github/workflows/golangci-lint\\.yml$/"
      ],
      "matchStrings": [
        "version: v(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update JavaScript and CSS CDN dependencies in Go templates",
      "managerFilePatterns": [
        "/\\.go$/"
      ],
      "matchStrings": [
        "https://(?:unpkg\\.com|cdn\\.jsdelivr\\.net/npm)/(?<depName>@?[^@\\s\"]+)@(?<currentValue>[\\d.]+)"
      ],
      "datasourceTemplate": "npm"
    }
  ],
  "automerge": true
}